# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa los valores con tus credenciales seguras.
# NUNCA subas el archivo .env real con credenciales al control de versiones.
# =============================================================================

# Configuración del Servidor y Base de Datos
PORT=8081
DB_URL=jdbc:postgresql://localhost:5433/onboarding
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# =============================================================================
# Configuración del Proveedor PuntoRed (GestoPago) - Pagos de Servicios
# =============================================================================

# URL base de la API transaccional de PuntoRed
PUNTORED_BASE_URL=https://gestopago.portalventas.net

# URL absoluta del servicio de autenticación / token (opcional)
PUNTORED_AUTH_URL=https://gestopago.portalventas.net/auth

# Ruta relativa del endpoint de autenticación JWT de GestoPago
PUNTORED_AUTH_PATH=/sistema/app/jwt-gp/authenticate/

# Identificador del distribuidor asignado por PuntoRed (GestoPago)
PUNTORED_ID_DISTRIBUIDOR=12345

# Código único del dispositivo o terminal transaccional (POS)
PUNTORED_CODIGO_DISPOSITIVO=DISP-9901-MX

# Usuario de acceso (si aplica)
PUNTORED_USUARIO=tu_usuario_puntored

# Contraseña o credencial de acceso para autenticación JWT
PUNTORED_PASSWORD=SecretPuntoRedPassword123!

# Nombre de la sucursal o unidad operativa para el campo "unidad" (3 a 25 caracteres)
PUNTORED_UNIDAD=SUCURSAL_CENTRO_01

# Zona horaria oficial para las transacciones (por defecto America/Mexico_City)
PUNTORED_ZONA_HORARIA=America/Mexico_City

# Llave simétrica AES de 128 o 256 bits codificada en Base64 para cifrado de tramas
# Ejemplo: Llave de 32 bytes (256-bit) en Base64
PUNTORED_AES_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Vector de inicialización (IV) AES de 16 bytes (128-bit) codificado en Base64
# Ejemplo: IV de 16 bytes en Base64
PUNTORED_AES_IV=MDEyMzQ1Njc4OWFiY2RlZg==

# Header X-API-Key (solo si PuntoRed te asignó uno; vacío => no se envía)
PUNTORED_API_KEY=

# Timeouts de conexión y lectura en milisegundos.
# PuntoRed espera hasta 62 s antes de responder CODIGO 82: el read timeout debe ser mayor.
PUNTORED_CONNECT_TIMEOUT=5000
PUNTORED_READ_TIMEOUT=70000

# Límites globales de monto por operación (si el producto del catálogo no define los suyos)
PUNTORED_MONTO_MINIMO=1.00
PUNTORED_MONTO_MAXIMO=5000.00

# Verificación automática de pagos con resultado desconocido (confirmTx / reenvío del mismo UPC)
# Antigüedad mínima antes de verificar (mayor que el read timeout)
PUNTORED_MINUTOS_ANTES_VERIFICAR=2
# Ventanas en las que PuntoRed detecta el UPC duplicado (15 min recargas / 24 h servicios), con margen
PUNTORED_VENTANA_REENVIO_RECARGA=10
PUNTORED_VENTANA_REENVIO_SERVICIO=1380
# Intentos antes de escalar a conciliación manual
PUNTORED_MAX_INTENTOS_VERIFICACION=5
# Cada cuánto corre la verificación (ms)
PUNTORED_CONCILIACION_INTERVALO_MS=120000

# Catálogo (getProductList.do está limitado por PuntoRed a 3 llamadas diarias)
PUNTORED_CATALOGO_LIMITE_DIARIO=3
# No se vuelve a consultar si la última sincronización exitosa tiene menos de estas horas (protege el cupo en reinicios)
PUNTORED_CATALOGO_HORAS_ENTRE_SYNC=20

# =============================================================================
# Seguridad de la API
# =============================================================================
# Administrador (HTTP Basic): clientes, cuentas y conciliación. Vacío => administración cerrada
ADMIN_USER=admin_conciliacion
ADMIN_PASSWORD=cambia_esta_password_admin

# Secreto para firmar el JWT de clientes (Base64, mínimo 32 bytes). Generar con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=15

# Orígenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Deshabilitar Swagger en producción
SWAGGER_ENABLED=true

# Estrategia DDL: update (por defecto) | validate (producción con migraciones) | create (solo desarrollo)
JPA_DDL_AUTO=update

# =============================================================================
# Configuración de Brevo (Sendinblue) - Correo Transaccional (API REST)
# =============================================================================

# API Key v3 de Brevo (xkeysib-...)
BREVO_API_KEY=xkeysib-ejemplo_api_key_falsa_para_entorno_de_pruebas_1234567890abcdef

# Correo electrónico verificado del remitente oficial
BREVO_SENDER_EMAIL=notificaciones@tudominiobancario.com

# Nombre público visible del remitente
BREVO_SENDER_NAME=Banco Digital Notificaciones

# URL base de la API REST de Brevo (por defecto https://api.brevo.com)
BREVO_BASE_URL=https://api.brevo.com

# Timeouts de conexión y lectura para Brevo en milisegundos
BREVO_CONNECT_TIMEOUT=5000
BREVO_READ_TIMEOUT=15000

